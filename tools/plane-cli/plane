    if getattr(args, "file", None):
        try:
            with open(args.file, "r", encoding="utf-8") as f:
                content = f.read()
        except Exception as e:
            print(red(f"Error reading file '{args.file}': {e}"), file=sys.stderr)
            sys.exit(1)
    elif getattr(args, "description", None) is not None:
        content = args.description

    if not payload and content is None:
        print(yellow("Nothing to update — pass at least one field."), file=sys.stderr)
