def _check_env():
    """Validate required environment variables and exit with helpful messages."""
    _load_env_file()
    if not API_KEY:
        print(red("Error: PLANE_API_KEY is not set."), file=sys.stderr)
        print(
            "\nTo get an API key:\n"
            "  1. Open Plane → Profile Settings → Personal Access Tokens\n"
            "  2. Create a new token and copy it\n"
            "  3. Export it:  export PLANE_API_KEY=\"your-token\"\n"
            "     Or save to: ~/.config/plane/env (PLANE_API_KEY=your-token)\n",
            file=sys.stderr,
        )
        sys.exit(1)
    if not WORKSPACE:
        print(red("Error: PLANE_WORKSPACE is not set."), file=sys.stderr)
        print(
            "\nSet it to your workspace slug (the part after plane.so/):\n"
            "  export PLANE_WORKSPACE=\"my-workspace\"\n"
            "     Or save to: ~/.config/plane/env (PLANE_WORKSPACE=my-workspace)\n",
            file=sys.stderr,
        )
        sys.exit(1)


def _validate_id(value: str, name: str = "ID") -> str:
    """
    Validate that an ID doesn't contain path-injection characters.
    
    Args:
        value: The ID string to validate.
        name:  Human-readable name for error messages.
    
    Returns:
        The validated ID.
    
    Raises:
        SystemExit if validation fails.
    """
    if "/" in value or "\\" in value or ".." in value:
        print(red(f"Invalid {name}: contains illegal characters"), file=sys.stderr)
        sys.exit(1)
    return value


def api(method: str, endpoint: str, data: Optional[Dict[str, Any]] = None, fatal: bool = True) -> Optional[Any]:
    """
    Make an authenticated request to the Plane API.

    Args:
        method:   HTTP method (GET, POST, PATCH, DELETE).
        endpoint: API path starting with / (e.g., /users/me/ or /api/workspaces/...).
        data:     Optional JSON body for POST/PATCH.
        fatal:    When False, HTTP errors return an error dict instead of exiting.

    Returns:
        Parsed JSON response, or None for 204 No Content. With fatal=False,
        HTTP errors return {"_http_error": <status>, "error": <body>}.
    """
    _check_env()

    if endpoint.startswith("/api/"):
        url = f"{BASE_URL}{endpoint}"
    else:
        url = f"{BASE_URL}/api/v1{endpoint}"
    
    # Defense-in-depth: ensure we only make HTTP(S) requests (Semgrep audit)
    if not url.startswith(("http://", "https://")):
        print(red(f"Invalid URL scheme: {url}"), file=sys.stderr)
        sys.exit(1)
    
    headers = {
        "X-API-Key": API_KEY,
        "X-Api-Key": API_KEY,
        "Content-Type": "application/json",
    }

    body = json.dumps(data).encode() if data else None
    req = Request(url, data=body, headers=headers, method=method)

    try:
        with urlopen(req, timeout=30) as resp:
            if resp.status == 204:
                return None
            return json.loads(resp.read().decode())
    except HTTPError as e:
        error_body = e.read().decode() if e.fp else str(e)
        try:
            error_json = json.loads(error_body)
            error_body = json.dumps(error_json, indent=2)
        except (json.JSONDecodeError, ValueError):
            pass
        if not fatal:
            return {"_http_error": e.code, "error": error_body}
        print(red(f"API Error {e.code}:") + f" {error_body}", file=sys.stderr)
        sys.exit(1)
    except URLError as e:
        print(red(f"Connection error: {e.reason}"), file=sys.stderr)
        sys.exit(1)
    except TimeoutError:
        print(red("Request timed out (30s). The Plane API may be unreachable."), file=sys.stderr)
        sys.exit(1)


def _file_metadata(path: str, content_type: Optional[str] = None) -> Tuple[str, int, str]:
    """Validate a local attachment and return name, size, and MIME type."""
    if not os.path.isfile(path):
        print(red(f"File not found: {path}"), file=sys.stderr)
        sys.exit(1)

    name = os.path.basename(path)
    extension_parts = name.lower().split(".")
    extension = extension_parts[-1] if len(extension_parts) > 1 else ""
    second_last_extension = extension_parts[-2] if len(extension_parts) > 2 else ""
    if name.startswith(".") or extension in DANGEROUS_EXTENSIONS or second_last_extension in DANGEROUS_EXTENSIONS:
        print(red(f"Unsafe attachment filename: {name}"), file=sys.stderr)
        sys.exit(1)

    size = os.path.getsize(path)
    if size <= 0:
        print(red("Attachment must not be empty."), file=sys.stderr)
        sys.exit(1)

    mime_type = content_type or mimetypes.guess_type(name)[0]
    if not mime_type:
        print(
            red("Could not determine the file MIME type. Pass --content-type explicitly."),
            file=sys.stderr,
        )
        sys.exit(1)
    mime_type = mime_type.lower().split(";", 1)[0].strip()
    if mime_type not in ATTACHMENT_MIME_TYPES:
        print(red(f"Unsupported attachment MIME type: {mime_type}"), file=sys.stderr)
        sys.exit(1)
    return name, size, mime_type


def _multipart_body(fields: Dict[str, Any], path: str, mime_type: str) -> Tuple[bytes, str]:
    """Build the multipart/form-data payload required by an S3 presigned POST."""
    boundary = f"----plane-cli-{secrets.token_hex(16)}"
    body = bytearray()

    for key, value in fields.items():
        body.extend(f"--{boundary}\r\n".encode())
        body.extend(f'Content-Disposition: form-data; name="{key}"\r\n\r\n'.encode())
        body.extend(str(value).encode())
        body.extend(b"\r\n")

    safe_name = os.path.basename(path).replace('"', "")
    body.extend(f"--{boundary}\r\n".encode())
    body.extend(
        f'Content-Disposition: form-data; name="file"; filename="{safe_name}"\r\n'.encode()
    )
    body.extend(f"Content-Type: {mime_type}\r\n\r\n".encode())
    with open(path, "rb") as file_handle:
        body.extend(file_handle.read())
    body.extend(b"\r\n")
    body.extend(f"--{boundary}--\r\n".encode())
    return bytes(body), boundary


def _upload_to_storage(upload_data: Dict[str, Any], path: str, mime_type: str) -> None:
    """Upload a file to the presigned storage URL without Plane API headers."""
    url = upload_data.get("url")
    fields = upload_data.get("fields")
    if not isinstance(url, str) or not url.startswith(("http://", "https://")) or not isinstance(fields, dict):
        print(red("Plane returned invalid presigned upload data."), file=sys.stderr)
        sys.exit(1)

    body, boundary = _multipart_body(fields, path, mime_type)
    request = Request(
        url,
        data=body,
        headers={"Content-Type": f"multipart/form-data; boundary={boundary}"},
        method="POST",
    )
    try:
        with urlopen(request, timeout=120):
            return
    except HTTPError as error:
        error_body = error.read().decode(errors="replace") if error.fp else str(error)
        print(red(f"Storage upload error {error.code}: {error_body}"), file=sys.stderr)
        sys.exit(1)
    except URLError as error:
        print(red(f"Storage connection error: {error.reason}"), file=sys.stderr)
        sys.exit(1)
    except TimeoutError:
        print(red("Storage upload timed out."), file=sys.stderr)
        sys.exit(1)


def _upload_project_asset(
    project: str,
    entity_type: str,
    entity_id: str,
    path: str,
    content_type: Optional[str] = None,
) -> Dict[str, Any]:
    """Create, transfer, and finalize a project-scoped Plane attachment."""
    _validate_id(project, "project ID")
    _validate_id(entity_id, "entity ID")
    name, size, mime_type = _file_metadata(path, content_type)
    endpoint = f"/api/assets/v2/workspaces/{WORKSPACE}/projects/{project}/"
    response = api(
        "POST",
        endpoint,
        {
            "name": name,
            "type": mime_type,
            "size": size,
            "entity_type": entity_type,
            "entity_identifier": entity_id,
        },
    )
    if not isinstance(response, dict) or not response.get("asset_id") or not response.get("upload_data"):
        print(red("Plane returned an invalid asset response."), file=sys.stderr)
        sys.exit(1)

    _upload_to_storage(response["upload_data"], path, mime_type)
    asset_id = _validate_id(str(response["asset_id"]), "asset ID")
    api("PATCH", f"{endpoint}{asset_id}/", {})

    result = dict(response)
    result.pop("upload_data", None)
    result.update({"name": name, "type": mime_type, "size": size})
    return result


def _embed_page_image(project: str, page: str, asset: Dict[str, Any]) -> None:
    """Append an uploaded image node and regenerate every Plane editor format."""
    asset_id = str(asset.get("asset_id") or "")
    asset_url = str(asset.get("asset_url") or "")
    if not asset_id or not asset_url:
        print(red("Plane did not return the asset data required for embedding."), file=sys.stderr)
        sys.exit(1)

    page_endpoint = f"/api/workspaces/{WORKSPACE}/projects/{project}/pages/{page}/"
    page_data = api("GET", page_endpoint)
    if not isinstance(page_data, dict):
        print(red("Plane returned invalid page data."), file=sys.stderr)
        sys.exit(1)

    description_html = page_data.get("description_html") or "<p></p>"
    image_node = (
        f'<image-component id="{html_escape(asset_id)}" '
        f'src="{html_escape(asset_url)}" status="uploaded"></image-component><p></p>'
    )
    updated_html = f"{description_html.rstrip()}{image_node}"
    response = api(
        "PATCH",
        f"{page_endpoint}description/",
        {"description_html": updated_html, "regenerate_binary": True},
    )
    if not isinstance(response, dict) or response.get("editor_data_regenerated") is not True:
        print(
            red("The Plane server did not confirm editor binary regeneration."),
            file=sys.stderr,
        )
        sys.exit(1)


# ---------------------------------------------------------------------------
_MD_LIST_RE = re.compile(r"^(\s*)([-*+]|\d{1,9}[.)])\s+(.*)$")
_MD_TASK_RE = re.compile(r"^\[( |x|X)\]\s+(.*)$")
_MD_HEADING_RE = re.compile(r"^(#{1,6})\s+(.*)$")
_MD_HR_RE = re.compile(r"^\s*([-*_])(\s*\1\s*){2,}$")
_MD_HTML_BLOCK_RE = re.compile(
    r"</?(p|div|h[1-6]|ul|ol|li|table|blockquote|pre|section|article|br|hr|img)\b",
    re.IGNORECASE,
)


def _looks_like_html(content: str) -> bool:
    c = content.strip()
    return (c.startswith("<") and c.endswith(">")) or bool(_MD_HTML_BLOCK_RE.search(c))


def _md_inline(text: str) -> str:
    """Convert inline markdown (code, bold, italic, strikethrough, links) to HTML."""
    text = html_escape(text)
    text = re.sub(r"`([^`\n]+)`", r"<code>\1</code>", text)
    text = re.sub(
        r"\*\*([^*]+)\*\*|__([^_]+)__",
        lambda m: f"<strong>{m.group(1) or m.group(2)}</strong>",
        text,
    )
    text = re.sub(r"(?<![\w*])\*([^*\n]+)\*", r"<em>\1</em>", text)
    text = re.sub(r"~~([^~]+)~~", r"<del>\1</del>", text)
    text = re.sub(r"!\[([^\]]*)\]\(([^)\s]+)\)", r'<img src="\2" alt="\1"/>', text)
    text = re.sub(r"\[([^\]]+)\]\(([^)\s]+)\)", r'<a href="\2">\1</a>', text)
    return text


def _markdown_to_html(md: str) -> str:
    """Minimal markdown → Plane editor HTML (headings, lists, tasks, tables, code, quotes)."""
    lines = md.replace("\r\n", "\n").replace("\r", "\n").split("\n")
    out: List[str] = []
    para: List[str] = []
    list_stack: List[Dict[str, Any]] = []
    i, n = 0, len(lines)

    def flush_para() -> None:
        if para:
            out.append("<p>" + "<br/>".join(_md_inline(x) for x in para) + "</p>")
            para.clear()

    def flush_lists() -> None:
        while list_stack:
            out.append(f"</{list_stack.pop()['close']}>")

    while i < n:
        line = lines[i]
        stripped = line.strip()

        # fenced code block
        if stripped.startswith("```") or stripped.startswith("~~~"):
            flush_para()
            flush_lists()
            fence = stripped[:3]
            lang = stripped[3:].strip()
            code_lines = []
            i += 1
            while i < n and not lines[i].strip().startswith(fence):
                code_lines.append(lines[i])
                i += 1
            i += 1  # skip closing fence
            cls = f' class="language-{html_escape(lang, quote=True)}"' if lang else ""
            out.append(f"<pre><code{cls}>{html_escape(chr(10).join(code_lines))}</code></pre>")
            continue

        if not stripped:
            flush_para()
            flush_lists()
            i += 1
            continue

        m = _MD_HEADING_RE.match(stripped)
        if m:
            flush_para()
            flush_lists()
            level = len(m.group(1))
            out.append(f"<h{level}>{_md_inline(m.group(2))}</h{level}>")
            i += 1
            continue

        if _MD_HR_RE.match(line):
            flush_para()
            flush_lists()
            out.append("<hr/>")
            i += 1
            continue

        # table (header row followed by a |---| separator row)
        if (
            "|" in line
            and i + 1 < n
            and "|" in lines[i + 1]
            and "-" in lines[i + 1]
            and re.match(r"^[\s\-:|]*$", lines[i + 1].strip().strip("|"))
        ):
            flush_para()
            flush_lists()
            header = [c.strip() for c in stripped.strip("|").split("|")]
            i += 2
            rows = []
            while i < n and lines[i].strip().startswith("|"):
                rows.append([c.strip() for c in lines[i].strip().strip("|").split("|")])
                i += 1
            thead = "".join(f"<th>{_md_inline(c)}</th>" for c in header)
            tbody = "".join(
                "<tr>" + "".join(f"<td>{_md_inline(c)}</td>" for c in r) + "</tr>" for r in rows
            )
            out.append(f"<table><tbody><tr>{thead}</tr>{tbody}</tbody></table>")
            continue

        # blockquote
        if stripped.startswith(">"):
            flush_para()
            flush_lists()
            quote_lines = []
            while i < n and lines[i].strip().startswith(">"):
                quote_lines.append(lines[i].strip()[1:].lstrip())
                i += 1
            out.append(
                "<blockquote><p>" + "<br/>".join(_md_inline(q) for q in quote_lines) + "</p></blockquote>"
            )
            continue

        # list item (bullets, ordered, task items; nested via indentation)
        m = _MD_LIST_RE.match(line)
        if m:
            flush_para()
            indent = len(m.group(1).replace("\t", "    "))
            task = _MD_TASK_RE.match(m.group(3))
            tag = "ol" if (m.group(2)[0].isdigit() and not task) else "ul"
            open_tag = '<ul data-type="taskList">' if task else f"<{tag}>"
            while list_stack and indent < list_stack[-1]["indent"]:
                out.append(f"</{list_stack.pop()['close']}>")
            if list_stack and indent == list_stack[-1]["indent"] and list_stack[-1]["open"] != open_tag:
                out.append(f"</{list_stack.pop()['close']}>")
            if not list_stack or indent > list_stack[-1]["indent"]:
                list_stack.append({"indent": indent, "close": tag, "open": open_tag})
                out.append(open_tag)
            if task:
                checked = ' data-checked="true"' if task.group(1).lower() == "x" else ' data-checked="false"'
                out.append(f'<li data-type="taskItem"{checked}><p>{_md_inline(task.group(2))}</p></li>')
            else:
                out.append(f"<li><p>{_md_inline(m.group(3))}</p></li>")
            i += 1
            continue

        flush_lists()
        para.append(stripped)
        i += 1

    flush_para()
    flush_lists()
    return "".join(out)


def _format_html_content(content: str) -> str:
    """Return content as HTML: passthrough if already HTML, else convert markdown."""
    content = content.strip()
    if _looks_like_html(content):
        return content
    return _markdown_to_html(content) or "<p></p>"


def _set_page_content(project: str, page_id: str, content_html: str) -> bool:
    """
    Write page body through the description endpoint so the server regenerates
    description_html, description_json, and description_binary (Yjs) together.
    Falls back to a plain description_html update when regeneration is
    unavailable (e.g. the live/convert service is not configured).
    """
    endpoint = f"/api/workspaces/{WORKSPACE}/projects/{project}/pages/{page_id}/description/"
    response = api(
        "PATCH",
        endpoint,
        {"description_html": content_html, "regenerate_binary": True},
        fatal=False,
    )
    if isinstance(response, dict) and response.get("editor_data_regenerated") is True:
        return True
    api(
        "PATCH",
        f"/api/workspaces/{WORKSPACE}/projects/{project}/pages/{page_id}/",
        {"description_html": content_html},
    )
    print(
        yellow(
            "⚠ Editor data was not regenerated (live service unavailable); "
            "updated description_html only. If the page was edited before, "
            "open it once in the web editor to sync."
        ),
        file=sys.stderr,
    )
    return False


def _truncate(text: str, width: int) -> str:
    """Truncate *text* to *width* chars, adding ellipsis if needed."""
    if len(text) <= width:
        return text
    return text[: width - 1] + "…"


def _resolve(val):
    """Pull a human-readable value out of nested dicts."""
    if isinstance(val, dict):
        return val.get("name", val.get("display_name", val.get("id", str(val))))
    if val is None:
        return "—"
    return str(val)


# Priority number → label mapping
_PRIORITY_LABELS = {0: "none", 1: "urgent", 2: "high", 3: "medium", 4: "low"}
_PRIORITY_COLORS = {
    "urgent": lambda t: _c("1;31", t),  # bold red
    "high": lambda t: _c("31", t),       # red
    "medium": lambda t: _c("33", t),     # yellow
    "low": lambda t: _c("34", t),        # blue
    "none": lambda t: dim(t),
}


def _priority_str(val) -> str:
    """Convert a priority value (int or str) to a colored label."""
    if isinstance(val, int):
        label = _PRIORITY_LABELS.get(val, str(val))
    else:
        label = str(val) if val else "none"
    color_fn = _PRIORITY_COLORS.get(label, str)
    return color_fn(label)


def _print_table(rows: List[Dict[str, Any]], columns: List[Tuple[str, str, int]]):
    """
    Print a list of dicts as an aligned table.

    *columns* is a list of (key, header, max_width) tuples.
    """
    if not rows:
        print(dim("No results."))
        return

    # Build string matrix
    header = [h for _, h, _ in columns]
    lines: List[List[str]] = []
    raw_lines: List[List[str]] = []  # without color for width calc

    for row in rows:
        cells = []
        raw_cells = []
        for key, _, maxw in columns:
            if key == "priority":
                raw_val = _resolve(row.get(key))
                raw_label = _PRIORITY_LABELS.get(row.get(key), raw_val) if isinstance(row.get(key), int) else raw_val
                cells.append(_priority_str(row.get(key)))
                raw_cells.append(raw_label)
            else:
                val = _truncate(_resolve(row.get(key)), maxw)
                cells.append(val)
                raw_cells.append(val)
        lines.append(cells)
        raw_lines.append(raw_cells)

    # Calculate column widths (max of header and content)
    widths = [len(h) for h in header]
    for raw in raw_lines:
        for i, cell in enumerate(raw):
            widths[i] = max(widths[i], len(cell))
    # Clamp to declared max
    for i, (_, _, maxw) in enumerate(columns):
        widths[i] = min(widths[i], maxw)

    # Print header
    hdr = "  ".join(bold(h.ljust(w)) for h, w in zip(header, widths))
    print(hdr)
    print(dim("─" * (sum(widths) + 2 * (len(widths) - 1))))

    # Print rows
    for cells, raw in zip(lines, raw_lines):
        parts = []
        for i, (cell, rc) in enumerate(zip(cells, raw)):
            # Pad using raw (uncolored) length
            pad = widths[i] - len(rc)
            parts.append(cell + " " * max(pad, 0))
        print("  ".join(parts))


def format_output(data, format_type: str = "table"):
    """
    Route data to the appropriate formatter.

    For JSON mode, dumps the raw API response.
    For table mode, auto-detects the shape and prints a readable table.
    """
    if format_type == "json":
        print(json.dumps(data, indent=2))
        return

    # Check for pagination and warn user
    has_more = False
    if isinstance(data, dict):
        if data.get("next") or data.get("next_page_offset") or data.get("next_cursor"):
            has_more = True

    # Unwrap paginated responses
    if isinstance(data, dict) and "results" in data:
        data = data["results"]
        if has_more:
            print(yellow("⚠ More results available (pagination not yet supported)"), file=sys.stderr)

    if isinstance(data, list):
        if not data:
            print(dim("No results."))
            return
        # Heuristic: pick table columns based on keys present
        sample = data[0] if data else {}
        if "name" in sample and "identifier" in sample:
            # Projects
            _print_table(data, [
                ("identifier", "ID", 10),
                ("name", "NAME", 40),
                ("id", "UUID", 36),
            ])
        elif "name" in sample and "priority" in sample:
            # Work items
            _print_table(data, [
                ("sequence_id", "SEQ", 8),
                ("name", "NAME", 50),
                ("priority", "PRI", 8),
                ("state", "STATE", 20),
                ("id", "UUID", 36),
            ])
        elif "name" in sample and "start_date" in sample:
            # Cycles or modules
            _print_table(data, [
                ("name", "NAME", 40),
                ("start_date", "START", 12),
                ("end_date", "END", 12),
                ("id", "UUID", 36),
            ])
        elif "display_name" in sample:
            # Members
            _print_table(data, [
                ("display_name", "NAME", 30),
                ("email", "EMAIL", 40),
                ("role", "ROLE", 10),
                ("id", "UUID", 36),
            ])
        elif "color" in sample and "name" in sample and ("is_locked" in sample or "view_props" in sample):
            # Pages
            _print_table(data, [
                ("name", "TITLE", 50),
                ("color", "COLOR", 10),
                ("created_at", "CREATED", 19),
                ("id", "UUID", 36),
            ])
        elif "query" in sample and "name" in sample and ("display_filters" in sample or "filters" in sample):
            # Views
            _print_table(data, [
                ("name", "NAME", 35),
                ("description", "DESCRIPTION", 35),
                ("created_at", "CREATED", 19),
                ("id", "UUID", 36),
            ])
        else:
            # Generic fallback
            cols = []
            for key in ["id", "identifier", "name", "title", "state", "priority", "sequence_id"]:
                if key in sample:
                    cols.append((key, key.upper(), 40))
            if cols:
                _print_table(data, cols)
            else:
                for item in data:
                    print(json.dumps(item, indent=2))
    elif isinstance(data, dict):
        # Single-object detail view
        max_key = max((len(k) for k in data if not k.startswith("_")), default=0)
        for k, v in data.items():
            if k.startswith("_"):
                continue
            label = bold(k.ljust(max_key))
            val = _resolve(v)
            print(f"  {label}  {val}")


