_UUID_RE = re.compile(
    r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
)


def _list_labels(project: str) -> List[Dict[str, Any]]:
    data = api("GET", f"/workspaces/{WORKSPACE}/projects/{project}/labels/")
    if isinstance(data, dict):
        return data.get("results", [])
    return data or []


def _find_label_by_name(project: str, name: str) -> Optional[str]:
    for label in _list_labels(project):
        if str(label.get("name", "")).lower() == name.lower():
            return label.get("id")
    return None


def _ensure_label(project: str, name_or_id: str) -> str:
    """Resolve a label name to its ID, creating the label if it doesn't exist."""
    if _UUID_RE.match(name_or_id):
        return name_or_id
    existing = _find_label_by_name(project, name_or_id)
    if existing:
        return existing
    created = api(
        "POST",
        f"/workspaces/{WORKSPACE}/projects/{project}/labels/",
        {"name": name_or_id},
        fatal=False,
    )
    if isinstance(created, dict) and created.get("id"):
        print(dim(f"  created label '{name_or_id}'"), file=sys.stderr)
        return created["id"]
    # duplicate-name conflict or other error — try resolving again
    existing = _find_label_by_name(project, name_or_id)
    if existing:
        return existing
    print(red(f"Could not resolve or create label: {name_or_id}"), file=sys.stderr)
    sys.exit(1)


def cmd_labels_list(args):
    """List labels in a project."""
    _validate_id(args.project, "project ID")
    data = api("GET", f"/workspaces/{WORKSPACE}/projects/{args.project}/labels/")
