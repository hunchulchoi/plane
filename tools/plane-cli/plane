def cmd_labels_create(args):
    """Create a label in a project."""
    _validate_id(args.project, "project ID")
    payload = {"name": args.name}
    if getattr(args, "color", None):
        payload["color"] = args.color
    if getattr(args, "description", None):
        payload["description"] = args.description
    data = api(
        "POST",
        f"/workspaces/{WORKSPACE}/projects/{args.project}/labels/",
        payload,
        fatal=False,
    )
    if isinstance(data, dict) and data.get("_http_error"):
        print(red(f"API Error {data['_http_error']}:") + f" {data.get('error', '')}", file=sys.stderr)
        sys.exit(1)
    print(green("✓ Label created"))
    format_output(data, args.format)


