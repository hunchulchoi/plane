def _html_to_text(html: str) -> str:
    """Very small HTML → plain-text conversion for comment bodies."""
    if not html:
        return ""
    text = re.sub(r"<br\s*/?>", "\n", html)
    text = re.sub(r"</(p|li|h[1-6]|blockquote|pre)\s*>", "\n", text)
    text = re.sub(r"<[^>]+>", "", text)
    return html_unescape(text).strip()


def cmd_comments_list(args):
    """List comments on a work item."""
    _validate_id(args.project, "project ID")
    _validate_id(args.issue, "issue ID")
    # Comments are stored separately from issue activity — the activities
    # endpoint does not include them, so query the comments endpoint directly.
    data = api(
        "GET",
        f"/api/workspaces/{WORKSPACE}/projects/{args.project}/issues/{args.issue}/comments/",
    )

    if isinstance(data, dict) and "results" in data:
        comments = data["results"]
    elif isinstance(data, list):
        comments = data
    else:
        comments = []

    activities = []
    if getattr(args, "all", False):
        act = api(
            "GET",
            f"/workspaces/{WORKSPACE}/projects/{args.project}/work-items/{args.issue}/activities/",
        )
        if isinstance(act, dict):
            activities = act.get("results", [])
        elif isinstance(act, list):
            activities = act

    if args.format == "json":
        if args.all:
            print(json.dumps({"comments": comments, "activities": activities}, indent=2))
        else:
            print(json.dumps(comments, indent=2))
        return

    printed = False
    for item in comments:
        actor = _resolve(item.get("actor_detail", item.get("actor", item.get("created_by", "?"))))
        body = _html_to_text(item.get("comment_html", "") or item.get("comment", ""))
        created = str(item.get("created_at", ""))[:19]
        print(f"  {bold(actor)}  {dim(created)}")
        print(f"    {body}")
        print()
        printed = True

    # --all additionally shows non-comment activity (field changes, etc.)
    for item in activities:
        field = item.get("field") or ""
        if field == "comment":
            continue  # already covered by the comments list
        actor = _resolve(item.get("actor_detail", item.get("actor", "?")))
        created = str(item.get("created_at", ""))[:19]
        verb = item.get("verb", "changed")
        note = item.get("comment")
        if note and not field:
            print(f"  {dim(created)}  {actor} {note}")
        else:
            print(f"  {dim(created)}  {actor} {verb} {field}: {item.get('old_value', '—')} → {item.get('new_value', '—')}")
        printed = True

    if not printed:
        print(dim("No comments found."))


