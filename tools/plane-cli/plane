def _load_env_file():
    global API_KEY, WORKSPACE, BASE_URL
    env_paths = [
        os.path.expanduser("~/.config/plane/env"),
        os.path.expanduser("~/.plane.env"),
        os.path.join(os.getcwd(), ".env"),
    ]
    for path in env_paths:
        if os.path.isfile(path):
            try:
                with open(path, "r", encoding="utf-8") as f:
                    for line in f:
                        line = line.strip()
                        if line and not line.startswith("#") and "=" in line:
                            k, v = line.split("=", 1)
                            k, v = k.strip(), v.strip().strip("\"'")
                            if k.startswith("export "):
                                k = k[7:].strip()
                            if k in (
                                "PLANE_API_KEY",
                                "PLANE_WORKSPACE",
                                "PLANE_WORKSPACE_SLUG",
                                "PLANE_WORKPACE_SLUG",
                                "PLANE_BASE_URL",
                                "PLANE_API_URL",
                            ):
                                if not os.environ.get(k):
                                    os.environ[k] = v
            except Exception:
                pass
    API_KEY = os.environ.get("PLANE_API_KEY")
    WORKSPACE = (
        os.environ.get("PLANE_WORKSPACE")
        or os.environ.get("PLANE_WORKSPACE_SLUG")
        or os.environ.get("PLANE_WORKPACE_SLUG")
    )
    BASE_URL = (
        os.environ.get("PLANE_BASE_URL")
        or os.environ.get("PLANE_API_URL")
        or "https://api.plane.so"
    ).rstrip("/")

_load_env_file()


