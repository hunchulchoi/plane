COMPOSE_PROJECT_NAME=plane
PLANE_HTTP_PORT=8220

WEB_URL=https://plane.devfor.link
APP_DOMAIN=plane.devfor.link
SECRET_KEY=replace-with-generated-value
LIVE_SERVER_SECRET_KEY=replace-with-generated-value

POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=plane
POSTGRES_USER=plane
POSTGRES_PASSWORD=replace-with-generated-value

REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/

RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=replace-with-generated-value
RABBITMQ_VHOST=plane

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-generated-value
AWS_SECRET_ACCESS_KEY=replace-with-generated-value
AWS_S3_ENDPOINT_URL=https://s3.devfor.link
AWS_S3_BUCKET_NAME=plane
USE_MINIO=0
MINIO_ENDPOINT_SSL=1
FILE_SIZE_LIMIT=5242880
SIGNED_URL_EXPIRATION=3600

DEBUG=0
CORS_ALLOWED_ORIGINS=https://plane.devfor.link
GUNICORN_WORKERS=2
API_KEY_RATE_LIMIT=60/minute
